  "table:columns": [
    {
      "name": "admin_code",
      "type": "string",
      "description": "元データにない、足した列。全国地方公共団体コード（5桁の文字列。チェックディジットなし）。元の KEN（都道府県コード）と CITY（市区町村コード）をつないだもの。2020年10月1日時点のコードで、政令指定都市は区ごと。"
    },
    {
      "name": "pref_code",
      "type": "string",
      "description": "元の列名: KEN。都道府県コード（2桁の文字列。01 北海道 〜 47 沖縄県）。"
    },
    {
      "name": "municipality_name",
      "type": "string",
      "description": "元の列名: CITYNAME。市区町村名（2020年10月1日時点）。政令指定都市の区は「札幌市北区」のように市の名前から書く。"
    },
    {
      "name": "did_number",
      "type": "int32",
      "description": "元の列名: CLASS。市区町村の中での人口集中地区の番号（1から）。人口の多い順で、1が最大。admin_code と did_number の組で1行が決まる。"
    },
    {
      "name": "population",
      "type": "int32",
      "description": "元の列名: JINKO。人口集中地区の人口（人。令和2年国勢調査）。"
    },
    {
      "name": "area_km2",
      "type": "double",
      "description": "元の列名: MENSEKI。人口集中地区の面積（km²。小数第2位まで）。元データの値で、geometry から計算したものではない。"
    },
    {
      "name": "bbox",
      "type": "struct<xmin: double, ymin: double, xmax: double, ymax: double>",
      "description": "地物の範囲（xmin、ymin、xmax、ymax）。GeoParquet 1.1 の bbox 列で、範囲で絞るときに行グループを読み飛ばすのに使う。"
    },
    {
      "name": "geometry",
      "type": "binary",
      "description": "人口集中地区の範囲（マルチポリゴン、EPSG:4326）。元データの5行にあった自己接触などの不正な形は ST_MakeValid で直した（面積は変わらない）。"
    }
  ],
