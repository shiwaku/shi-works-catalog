  "table:columns": [
    {
      "name": "admin_code",
      "type": "string",
      "description": "元の列名: N03_007。全国地方公共団体コード（5桁の文字列。チェックディジットなし）。都道府県コード2桁と市区町村コード3桁。政令指定都市は区ごとのコード。所属未定地は「<都道府県コード>000」。1行に1つで、重複しない。"
    },
    {
      "name": "pref_code",
      "type": "string",
      "description": "元データにない、足した列。都道府県コード（2桁の文字列。01 北海道 〜 47 沖縄県）。admin_code の先頭2桁。"
    },
    {
      "name": "pref_name",
      "type": "string",
      "description": "元の列名: N03_001。都道府県名。"
    },
    {
      "name": "subprefecture_name",
      "type": "string",
      "description": "元の列名: N03_002。北海道の振興局名。北海道以外は空。"
    },
    {
      "name": "county_name",
      "type": "string",
      "description": "元の列名: N03_003。郡名。郡に属する町村だけにあり、市・区・郡に属さない町村（島しょなど）は空。"
    },
    {
      "name": "municipality_name",
      "type": "string",
      "description": "元の列名: N03_004。市区町村名（市、町、村、東京都の特別区）。政令指定都市の区の行では市の名前（「札幌市」など）で、区の名前は ward_name にある。所属未定地の行は「所属未定地」。"
    },
    {
      "name": "ward_name",
      "type": "string",
      "description": "元の列名: N03_005。政令指定都市の行政区名（「中央区」など）。政令指定都市以外は空。東京都の特別区はここではなく municipality_name にある。"
    },
    {
      "name": "bbox",
      "type": "struct<xmin: double, ymin: double, xmax: double, ymax: double>",
      "description": "地物の範囲（xmin、ymin、xmax、ymax）。GeoParquet 1.1 の bbox 列で、範囲で絞るときに行グループを読み飛ばすのに使う。"
    },
    {
      "name": "geometry",
      "type": "binary",
      "description": "市区町村（政令指定都市は区）の範囲（マルチポリゴン、EPSG:4326）。元データでは島ごとに別の行だったものを、1つのマルチポリゴンにまとめた（形は変えていない）。"
    }
  ],
